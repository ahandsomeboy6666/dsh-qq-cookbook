{
  "_comment": "通用模板：不要填真实值，复制成 config.local.json 后再填。config.local.json 不提交（.gitignore）。",
  "qq": {
    "wsUrl": "ws://127.0.0.1:6701",
    "httpUrl": "http://127.0.0.1:6700",
    "accessToken": ""
  },
  "napcat": {
    "dir": "<你的 NapCat Shell 目录>",
    "launcher": "<NapCat 启动脚本路径>",
    "note": "NapCat 目录按你的机器填写；具体版本号随安装包变化"
  },
  "access": {
    "owner": "<你的 QQ 号>",
    "private": ["<你的 QQ 号>"],
    "groups": ["<群号，可留空>"]
  },
  "group": {
    "replyAt": false,
    "wake": {
      "enabled": true,
      "probability": 0.1,
      "followMinutes": 5,
      "bufferSize": 200,
      "recentLimit": 8,
      "nicknames": ["<机器人昵称>"],
      "note": "被 @ / 命中昵称必唤醒；其余按概率，没抽中的只进缓冲不调模型"
    }
  },
  "persona": {
    "private": "roles/肥鱼-私聊.md",
    "group": "roles/肥鱼-群聊.md",
    "maxInjectChars": 6000
  },
  "allowance": {
    "enabled": true,
    "currency": "CNY",
    "perOrder": 30,
    "perDay": 60,
    "perMonth": 300,
    "maxOrdersPerDay": 5,
    "beneficiaries": ["owner", "self"],
    "transfer": false,
    "note": "小号只充余额、不绑卡；受益人只有 owner 与 self；转账/红包永远拒绝"
  },
  "voice": {
    "enabled": false,
    "engine": "sweet",
    "note": "默认不接入语音；启用与各方案见 docs/20-tts-selection.md",
    "customUrl": "http://127.0.0.1:8090/tts?text={text}"
  },
  "tools": {
    "browser": {
      "enabled": true,
      "mode": "private-only",
      "note": "群聊不开放浏览器与购物"
    }
  }
}
