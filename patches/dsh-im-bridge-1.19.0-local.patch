+/** `groupWake: {...}` — 群聊唤醒策略：@/昵称/跟随窗口/概率，其余只记录不调模型。 */
+function normalizeGroupWake(value) {
+  if (!value || typeof value !== 'object' || value.enabled === false) return null;
+  const clamp = (input, fallback, min, max) => {
+    const number = Number(input);
+    return Number.isFinite(number) ? Math.min(max, Math.max(min, number)) : fallback;
+  };
+  const nicknames = strList(value.nicknames);
+  return {
+    probability: clamp(value.probability, 0.05, 0, 1),
+    followMinutes: clamp(value.followMinutes, 5, 0, 60),
+    bufferSize: Math.floor(clamp(value.bufferSize, 200, 10, 1000)),
+    recentLimit: Math.floor(clamp(value.recentLimit, 8, 1, 50)),
+    nicknames: nicknames.length ? nicknames : ['肥鱼', '大肥鱼'],
+  };
+}
